# Copy to .env only if your process manager loads environment files.
MARKETFORGE_ENV=local
MARKETFORGE_HOST=127.0.0.1
MARKETFORGE_PORT=7070
MARKETFORGE_DOCS=true
MARKETFORGE_MAX_UPLOAD_BYTES=15728640
MARKETFORGE_MAX_REQUEST_BYTES=17825792
MARKETFORGE_MAX_ROWS=250000
MARKETFORGE_MAX_COLUMNS=64
MARKETFORGE_MAX_BACKTEST_EVALUATIONS=750
MARKETFORGE_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
MARKETFORGE_MAX_COMPARISON_EVALUATIONS=2000

# Bound expensive forecast/backtest jobs
MARKETFORGE_MAX_CONCURRENT_JOBS=2
